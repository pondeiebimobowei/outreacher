{
  "name": "@repo/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/cjs/src/index.js",
  "module": "./dist/es/src/index.js",
  "types": "./dist/es/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/es/src/index.d.ts",
      "import": "./dist/es/src/index.js",
      "require": "./dist/cjs/src/index.js",
      "default": "./dist/es/src/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.es.json && tsc -p tsconfig.cjs.json && node -e \"fs.mkdirSync('./dist/cjs',{recursive:true});fs.writeFileSync('./dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}');const f='./dist/cjs/generated/prisma/client.js';if(fs.existsSync(f)){let c=fs.readFileSync(f,'utf8');c=c.replace('import.meta.url','require(\\\"url\\\").pathToFileURL(__filename).toString()');fs.writeFileSync(f,c);}\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@repo/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.11",
    "prisma": "^7.10.0",
    "tsx": "^4.19.2"
  }
}
