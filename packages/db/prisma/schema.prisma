generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

enum MessageKind {
  INBOUND
  OUTBOUND
}

enum WorkspaceRole {
  OWNER
}

enum CompanyStatus {
  ACTIVE
  ARCHIVED
}

enum ResearchRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum OpportunityType {
  CONFIRMED
  PROACTIVE
  UNCLASSIFIED
}

enum OpportunityStatus {
  ACTIVE
  CLOSED
  SUPERSEDED
}

enum PersonKind {
  PERSON
  ROLE_ADDRESS
}

enum OutreachStatus {
  DRAFT
  APPROVED
  SENDING
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum EvidenceClassification {
  FACT
  INFERENCE
  UNKNOWN
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum CampaignRecipientStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  SUPPRESSED
  FAILED
  REMOVED
}

enum ContentSource {
  MANUAL
  TEMPLATE
  AI
}

enum EmailSendType {
  INITIAL
  FOLLOW_UP
}

enum EmailSendStatus {
  PENDING
  RESERVED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum EmailEventType {
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

enum SuppressionReason {
  USER_REQUEST
  UNSUBSCRIBED
  BOUNCED
  COMPLAINT
  MANUAL
  SYSTEM
}

enum SuppressionAction {
  SUPPRESSED
  UNSUPPRESSED
}

enum JobCancellationReason {
  PAUSED
  SUPPRESSED
  CANCELLED_BY_USER
}

enum OutcomeType {
  QUALIFIED_CONVERSATION
  INTERESTED_NOT_QUALIFIED
  REFERRAL
  NOT_INTERESTED
  REJECTED
  NO_RESPONSE
  OTHER
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum IntegrationProvider {
  RESEND
  SES
  SMTP
}

enum IntegrationStatus {
  ACTIVE
  INVALID_CREDENTIALS
  DISABLED
}

enum SenderStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum AssignmentStatus {
  ACTIVE
  REMOVED
}

enum ReplyStatus {
  UNCORRELATED
  CORRELATED
  AMBIGUOUS
}

enum JobType {
  COMPANY_RESEARCH
  CONTACT_DISCOVERY
  OUTREACH_GENERATION
  EMAIL_DISPATCH
  SCHEDULED_FOLLOW_UP_CHECK
  WEBHOOK_PROCESSING
}

enum ConversationState {
  NO_REPLY
  REPLIED
  ACTIVE
  STOPPED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspaceMembers     WorkspaceMember[]
  authIdentities       AuthIdentity[]
  recordedOutcomes     Outcome[]
  createdSuppressions  Suppression[]
  suppressionHistories SuppressionHistory[]

  @@map("users")
}

model AuthIdentity {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  passwordHash   String?      @map("password_hash")
  email          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members                   WorkspaceMember[]
  careerProfiles            CareerProfile[]
  companies                 Company[]
  researchRuns              ResearchRun[]
  opportunities             Opportunity[]
  evidence                  Evidence[]
  outreaches                Outreach[]
  campaigns                 Campaign[]
  campaignRecipients        CampaignRecipient[]
  personCompanyAssociations PersonCompanyAssociation[]
  emailSends                EmailSend[]
  emailEvents               EmailEvent[]
  suppressions              Suppression[]
  suppressionHistories      SuppressionHistory[]
  outcomes                  Outcome[]
  emailTemplates            EmailTemplate[]
  jobs                      Job[]
  idempotencyRecords        IdempotencyRecord[]
  integrations              Integration[]
  senderAccounts            SenderAccount[]
  campaignSenderAccounts    CampaignSenderAccount[]
  inboundReplies            InboundReply[]
  conversationMessages      ConversationMessage[]
  people                    Person[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model CareerProfile {
  id                       String   @id @default(uuid())
  workspaceId              String   @unique @map("workspace_id")
  headline                 String?
  summary                  String?
  currentRole              String?  @map("current_role")
  targetRoles              String[] @default([]) @map("target_roles")
  yearsExperience          String?  @map("years_experience")
  careerGoals              String?  @map("career_goals")
  targetIndustries         String[] @default([]) @map("target_industries")
  targetLocations          String[] @default([]) @map("target_locations")
  skills                   String[] @default([])
  experienceSummary        String?  @map("experience_summary")
  portfolioUrl             String?  @map("portfolio_url")
  githubUrl                String?  @map("github_url")
  linkedinUrl              String?  @map("linkedin_url")
  websiteUrl               String?  @map("website_url")
  backgroundAndPositioning String?  @map("background_and_positioning")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("career_profiles")
}

model Company {
  id             String        @id @default(uuid())
  workspaceId    String        @map("workspace_id")
  name           String
  normalizedName String        @map("normalized_name")
  websiteUrl     String?       @map("website_url")
  domain         String?
  phoneNumber    String?       @map("phone_number")
  description    String?
  industry       String?
  location       String?
  linkedinUrl    String?       @map("linkedin_url")
  status         CompanyStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  workspace                 Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  personCompanyAssociations PersonCompanyAssociation[]
  researchRuns              ResearchRun[]
  opportunities             Opportunity[]
  evidence                  Evidence[]

  @@unique([workspaceId, normalizedName])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("companies")
}

model ConversationMessage {
  id          String      @id @default(uuid())
  workspaceId String      @map("workspace_id")
  outreachId  String      @map("outreach_id")
  kind        MessageKind
  subject     String
  body        String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outreach  Outreach  @relation(fields: [outreachId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([outreachId])
  @@map("conversation_messages")
}

model ResearchRun {
  id             String            @id @default(uuid())
  workspaceId    String            @map("workspace_id")
  companyId      String            @map("company_id")
  status         ResearchRunStatus @default(QUEUED)
  startedAt      DateTime?         @map("started_at")
  completedAt    DateTime?         @map("completed_at")
  provider       String?
  errorCode      String?           @map("error_code")
  errorMessage   String?           @map("error_message")
  idempotencyKey String?           @map("idempotency_key")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  evidence      Evidence[]

  @@unique([workspaceId, idempotencyKey])
  @@map("research_runs")
}

model Opportunity {
  id                  String            @id @default(uuid())
  workspaceId         String            @map("workspace_id")
  companyId           String            @map("company_id")
  researchRunId       String?           @map("research_run_id")
  opportunityType     OpportunityType   @default(UNCLASSIFIED) @map("opportunity_type")
  status              OpportunityStatus @default(ACTIVE)
  roleTitle           String?           @map("role_title")
  roleUrl             String?           @map("role_url")
  roleLocation        String?           @map("role_location")
  roleDescription     String?           @map("role_description")
  openingSourceUrl    String?           @map("opening_source_url")
  openingDiscoveredAt DateTime?         @map("opening_discovered_at")
  confidence          String?
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  researchRun        ResearchRun?        @relation(fields: [researchRunId], references: [id], onDelete: SetNull)
  evidence           Evidence[]
  campaignRecipients CampaignRecipient[]

  @@index([workspaceId, companyId])
  @@index([workspaceId, status])
  @@map("opportunities")
}

model Person {
  id           String     @id @default(uuid())
  workspaceId  String     @map("workspace_id")
  personKind   PersonKind @default(PERSON) @map("person_kind")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  email        String?
  websiteUrl   String?    @map("website_url")
  linkedinUrl  String?    @map("linkedin_url")
  title        String?
  source       String?
  note         String?
  sourceUrl    String?    @map("source_url")
  confidence   String?
  discoveredAt DateTime?  @map("discovered_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  workspace                 Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  evidence                  Evidence[]
  personCompanyAssociations PersonCompanyAssociation[]

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([workspaceId, email])
  @@map("persons")
}

model PersonCompanyAssociation {
  id                String            @id @default(uuid())
  workspaceId       String            @map("workspace_id")
  personId          String            @map("person_id")
  workEmail         String?           @map("work_email")
  companyId         String            @map("company_id")
  role              String?
  team              String?
  whyThisPerson     String?           @map("why_this_person")
  conversationAngle String?           @map("conversation_angle")
  conversationState ConversationState @default(NO_REPLY) @map("conversation_state")
  stateVersion      Int               @default(0) @map("state_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  person             Person              @relation(fields: [personId], references: [id], onDelete: Cascade)
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outreaches         Outreach[]
  campaignRecipients CampaignRecipient[]

  @@unique([workspaceId, personId, companyId])
  @@index([workspaceId, conversationState])
  @@map("person_company_associations")
}

model Evidence {
  id                   String                 @id @default(uuid())
  workspaceId          String                 @map("workspace_id")
  companyAssociationId String                 @map("company_association_id")
  companyId            String                 @map("company_id")
  opportunityId        String?                @map("opportunity_id")
  personId             String?                @map("person_id")
  researchRunId        String?                @map("research_run_id")
  claim                String
  classification       EvidenceClassification @default(UNKNOWN)
  sourceName           String?                @map("source_name")
  sourceUrl            String?                @map("source_url")
  sourceExcerpt        String?                @map("source_excerpt")
  collectedAt          DateTime?              @map("collected_at")
  confidence           String?
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  person      Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  researchRun ResearchRun? @relation(fields: [researchRunId], references: [id], onDelete: SetNull)

  @@index([workspaceId, companyId])
  @@index([workspaceId, opportunityId])
  @@index([workspaceId, personId])
  @@map("evidence")
}

model EmailTemplate {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps      EmailTemplateStep[]
  campaigns  Campaign[]
  outreaches Outreach[]

  @@unique([workspaceId, name])
  @@map("email_templates")
}

model EmailTemplateStep {
  id              String   @id @default(uuid())
  templateId      String   @map("template_id")
  sequence        Int      @default(0)
  subjectTemplate String   @map("subject_template")
  bodyTemplate    String   @map("body_template")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  template EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, sequence])
  @@map("email_template_steps")
}

model Campaign {
  id                        String         @id @default(uuid())
  workspaceId               String         @map("workspace_id")
  name                      String
  status                    CampaignStatus @default(DRAFT)
  contentSource             ContentSource  @default(TEMPLATE) @map("content_source")
  templateId                String?        @map("template_id")
  aiPromptContext           String?        @map("ai_prompt_context")
  followUpDelayBusinessDays Int            @default(4) @map("follow_up_delay_business_days")
  maxFollowUps              Int            @default(2) @map("max_follow_ups")
  createdAt                 DateTime       @default(now()) @map("created_at")
  updatedAt                 DateTime       @updatedAt @map("updated_at")

  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template               EmailTemplate?          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  recipients             CampaignRecipient[]
  campaignSenderAccounts CampaignSenderAccount[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@map("campaigns")
}

model CampaignRecipient {
  id                         String                  @id @default(uuid())
  workspaceId                String                  @map("workspace_id")
  campaignId                 String                  @map("campaign_id")
  personCompanyAssociationId String                  @map("person_company_association_id")
  status                     CampaignRecipientStatus @default(PENDING)
  targetRole                 String?                 @map("target_role")
  selectedOpportunityId      String?                 @map("selected_opportunity_id")
  createdAt                  DateTime                @default(now()) @map("created_at")
  updatedAt                  DateTime                @updatedAt @map("updated_at")

  workspace                Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign                 Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  personCompanyAssociation PersonCompanyAssociation @relation(fields: [personCompanyAssociationId], references: [id], onDelete: Cascade)
  opportunity              Opportunity?             @relation(fields: [selectedOpportunityId], references: [id], onDelete: SetNull)
  outreach                 Outreach?

  @@unique([workspaceId, campaignId, personCompanyAssociationId])
  @@index([workspaceId, campaignId])
  @@index([workspaceId, personCompanyAssociationId])
  @@index([workspaceId, status])
  @@map("campaign_recipients")
}

model Outreach {
  id                         String         @id @default(uuid())
  workspaceId                String         @map("workspace_id")
  personCompanyAssociationId String         @map("person_company_association_id")
  campaignRecipientId        String?        @unique @map("campaign_recipient_id")
  senderAccountId            String?        @map("sender_account_id")
  contentSource              ContentSource  @default(MANUAL) @map("content_source")
  templateId                 String?        @map("template_id")
  aiPromptContext            String?        @map("ai_prompt_context")
  draftVersion               Int            @default(0) @map("draft_version")
  subject                    String         @default("")
  message                    String         @default("")
  outreachReason             String?        @map("outreach_reason")
  status                     OutreachStatus @default(DRAFT)
  maxFollowUps               Int            @default(2) @map("max_follow_ups")
  createdAt                  DateTime       @default(now()) @map("created_at")
  updatedAt                  DateTime       @updatedAt @map("updated_at")

  workspace                Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  personCompanyAssociation PersonCompanyAssociation @relation(fields: [personCompanyAssociationId], references: [id], onDelete: Cascade)
  campaignRecipient        CampaignRecipient?       @relation(fields: [campaignRecipientId], references: [id], onDelete: SetNull)
  senderAccount            SenderAccount?           @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)
  template                 EmailTemplate?           @relation(fields: [templateId], references: [id], onDelete: Restrict)
  emailSends               EmailSend[]
  conversationMessages     ConversationMessage[]
  inboundReplies           InboundReply[]
  outcome                  Outcome?

  @@index([workspaceId])
  @@index([personCompanyAssociationId])
  @@index([workspaceId, status])
  @@map("outreaches")
}

model EmailSend {
  id                     String          @id @default(uuid())
  workspaceId            String          @map("workspace_id")
  outreachId             String          @map("outreach_id")
  senderAccountId        String          @map("sender_account_id")
  sequence               Int             @default(0)
  type                   EmailSendType   @default(INITIAL)
  subject                String
  body                   String
  status                 EmailSendStatus @default(PENDING)
  expectedStateVersion   Int?            @map("expected_state_version")
  scheduledAt            DateTime?       @map("scheduled_at")
  reservedAt             DateTime?       @map("reserved_at")
  sentAt                 DateTime?       @map("sent_at")
  failedAt               DateTime?       @map("failed_at")
  firstProviderAttemptAt DateTime?       @map("first_provider_attempt_at")
  providerMessageId      String?         @map("provider_message_id")
  messageId              String?         @map("message_id")
  replyToToken           String?         @unique @map("reply_to_token")
  provider               String?
  errorCode              String?         @map("error_code")
  errorMessage           String?         @map("error_message")
  retryable              Boolean         @default(true)
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outreach      Outreach       @relation(fields: [outreachId], references: [id], onDelete: Cascade)
  senderAccount SenderAccount  @relation(fields: [senderAccountId], references: [id], onDelete: Restrict)
  emailEvents   EmailEvent[]

  @@unique([outreachId, sequence])
  @@index([workspaceId, outreachId])
  @@index([workspaceId, status])
  @@index([workspaceId, scheduledAt])
  @@index([workspaceId, senderAccountId, createdAt])
  @@index([providerMessageId])
  @@index([workspaceId, messageId])
  @@map("email_sends")
}

model EmailEvent {
  id              String         @id @default(uuid())
  workspaceId     String         @map("workspace_id")
  emailSendId     String         @map("email_send_id")
  provider        String
  providerEventId String         @map("provider_event_id")
  eventType       EmailEventType @map("event_type")
  occurredAt      DateTime       @map("occurred_at")
  payload         Json?
  createdAt       DateTime       @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailSend EmailSend @relation(fields: [emailSendId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([emailSendId])
  @@index([occurredAt])
  @@map("email_events")
}

model Suppression {
  id              String            @id @default(uuid())
  workspaceId     String            @map("workspace_id")
  email           String
  reason          SuppressionReason @default(MANUAL)
  source          String?
  createdByUserId String?           @map("created_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([workspaceId, email])
  @@map("suppressions")
}

model SuppressionHistory {
  id          String            @id @default(uuid())
  workspaceId String            @map("workspace_id")
  email       String
  action      SuppressionAction
  reason      SuppressionReason @default(MANUAL)
  source      String?
  notes       String?
  actorUserId String?           @map("actor_user_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorUser User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@map("suppression_history")
}

model Outcome {
  id               String      @id @default(uuid())
  workspaceId      String      @map("workspace_id")
  outreachId       String      @unique @map("outreach_id")
  recordedByUserId String      @map("recorded_by_user_id")
  type             OutcomeType
  notes            String?
  recordedAt       DateTime    @default(now()) @map("recorded_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outreach       Outreach  @relation(fields: [outreachId], references: [id], onDelete: Cascade)
  recordedByUser User      @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, outreachId])
  @@map("outcomes")
}

model Job {
  id                 String                 @id @default(uuid())
  workspaceId        String                 @map("workspace_id")
  type               JobType
  status             JobStatus              @default(PENDING)
  payload            Json
  attemptCount       Int                    @default(0) @map("attempt_count")
  maxAttempts        Int                    @default(3) @map("max_attempts")
  availableAt        DateTime               @default(now()) @map("available_at")
  startedAt          DateTime?              @map("started_at")
  completedAt        DateTime?              @map("completed_at")
  failedAt           DateTime?              @map("failed_at")
  lastError          String?                @map("last_error")
  idempotencyKey     String                 @map("idempotency_key")
  cancellationReason JobCancellationReason? @map("cancellation_reason")
  leaseVersion       Int                    @default(0) @map("lease_version")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, type, idempotencyKey])
  @@index([workspaceId, status, availableAt])
  @@map("jobs")
}

model IdempotencyRecord {
  id             String    @id @default(uuid())
  workspaceId    String    @map("workspace_id")
  operation      String
  key            String
  targetId       String    @map("target_id")
  requestHash    String    @map("request_hash")
  jobId          String?   @map("job_id")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, operation, key])
  @@index([workspaceId, targetId])
  @@map("idempotency_records")
}

model Integration {
  id                     String              @id @default(uuid())
  workspaceId            String              @map("workspace_id")
  provider               IntegrationProvider
  name                   String
  status                 IntegrationStatus   @default(ACTIVE)
  secretReference        String              @map("secret_reference")
  webhookSecretReference String?             @map("webhook_secret_reference")
  metadata               Json?
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  senderAccounts SenderAccount[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@map("integrations")
}

model SenderAccount {
  id            String       @id @default(uuid())
  workspaceId   String       @map("workspace_id")
  integrationId String       @map("integration_id")
  fromName      String       @map("from_name")
  fromEmail     String       @map("from_email")
  replyTo       String?      @map("reply_to")
  status        SenderStatus @default(ACTIVE)
  dailyLimit    Int          @default(50) @map("daily_limit")
  sendingWindow Json?        @map("sending_window")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration            Integration             @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Restrict)
  campaignSenderAccounts CampaignSenderAccount[]
  emailSends             EmailSend[]
  outreaches             Outreach[]

  @@unique([workspaceId, fromEmail])
  @@unique([workspaceId, id])
  @@index([workspaceId, integrationId])
  @@index([workspaceId, status])
  @@map("sender_accounts")
}

model CampaignSenderAccount {
  id              String           @id @default(uuid())
  workspaceId     String           @map("workspace_id")
  campaignId      String           @map("campaign_id")
  senderAccountId String           @map("sender_account_id")
  status          AssignmentStatus @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign      Campaign      @relation(fields: [workspaceId, campaignId], references: [workspaceId, id], onDelete: Cascade)
  senderAccount SenderAccount @relation(fields: [workspaceId, senderAccountId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([campaignId, senderAccountId])
  @@index([workspaceId, campaignId])
  @@index([workspaceId, senderAccountId])
  @@map("campaign_sender_accounts")
}

model InboundReply {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  outreachId  String? @map("outreach_id")

  provider        String   @default("RESEND")
  providerEventId String   @map("provider_event_id")
  providerEmailId String?  @map("provider_email_id")
  messageId       String?  @map("message_id")
  inReplyTo       String?  @map("in_reply_to")
  references      String[] @default([])
  replyToToken    String?  @map("reply_to_token")

  fromName  String? @map("from_name")
  fromEmail String  @map("from_email")
  toEmail   String  @map("to_email")

  subject  String?
  bodyText String? @map("body_text")
  bodyHtml String? @map("body_html")

  status ReplyStatus @default(UNCORRELATED)

  receivedAt DateTime @default(now()) @map("received_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outreach  Outreach? @relation(fields: [outreachId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, provider, providerEventId])
  @@index([workspaceId])
  @@index([workspaceId, outreachId])
  @@map("inbound_replies")
}
