{
  "name": "outreacher",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,js,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,js,mjs}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "check-types": "turbo run check-types",
    "typecheck": "turbo run check-types",
    "db:generate": "pnpm --filter @repo/db run prisma:generate",
    "db:migrate:dev": "pnpm --filter @repo/db run prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @repo/db run prisma:migrate:deploy",
    "db:studio": "pnpm --filter @repo/db run prisma:studio"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.13"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.20.0"
  }
}
