{
  "moduleFileExtensions": ["js", "json", "ts", "mjs"],
  "rootDir": "..",
  "modulePathIgnorePatterns": ["<rootDir>/dist"],
  "unmockedModulePathPatterns": ["@repo/db"],
  "moduleNameMapper": {
    "^@repo/db$": "<rootDir>/../../packages/db/dist/cjs/src/index.js"
  },
  "testEnvironment": "node",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "maxWorkers": 1,
  "transform": {
    "^.+\\.(t|j|mj)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["/node_modules/(?!(\\.pnpm|@nestjs|@prisma|svix))"]
}
