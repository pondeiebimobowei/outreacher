{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "AUTH_SECRET",
    "VITE_API_URL",
    "MODE",
    "DEV",
    "PROD",
    "POSTGRES_DATABASE",
    "PGDATABASE",
    "POSTGRES_PASSWORD",
    "POSTGRES_URL",
    "POSTGRES_PRISMA_URL",
    "POSTGRES_URL_NO_SSL",
    "NEON_AUTH_BASE_URL",
    "PGPASSWORD",
    "DATABASE_URL_UNPOOLED",
    "POSTGRES_HOST",
    "PGUSER",
    "NEON_PROJECT_ID",
    "POSTGRES_URL_NON_POOLING",
    "VITE_NEON_AUTH_URL",
    "PGHOST_UNPOOLED",
    "PGHOST",
    "POSTGRES_USER",
    "FRONTEND_URL",
    "AI_PROVIDER",
    "REPLY_EMAIL_DOMAIN",
    "RESEND_API_KEY",
    "RESEND_WEBHOOK_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CALLBACK_URL",
    "GOOGLE_CLIENT_SECRET"
  ],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "dependsOn": ["^build"],
      "outputs": [
        "build/**",
        ".vercel/**",
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
